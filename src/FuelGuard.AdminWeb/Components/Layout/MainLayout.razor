@inherits LayoutComponentBase
@inject IWebHostEnvironment Environment

<div class="app-shell">
    <header class="app-topbar">
        <a class="brand-mark" href="/">
            <span class="brand-icon">FG</span>
            <span>FuelGuard<small>ROMVEX simulator</small></span>
        </a>
        <span class="topbar-status">
            @if (Environment.IsDevelopment())
            {
                <span><span class="status-light"></span> DEVELOPMENT SIMULATOR</span>
            }
            else
            {
                <span>SIMULATOR DISABLED OUTSIDE DEVELOPMENT</span>
            }
        </span>
    </header>
    <main class="app-content">
        @Body
    </main>
    <footer class="app-footer">
        <span>Phase 1 demonstration environment</span>
        <span>No real payment processing · No physical actuation</span>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>
