<Project>
  <PropertyGroup>
	<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
	<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
	<PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
	<PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
	<PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
	<PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
	<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0-rc.3.26522.148" />
	<PackageVersion Include="QRCoder" Version="1.8.1" />
	<PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
	<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
	<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
	<PackageVersion Include="xunit" Version="2.9.3" />
	<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
	<PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>
